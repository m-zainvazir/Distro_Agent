{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python .claude/hooks/lint_hook.py 2>/dev/null || true",
            "shell": "bash",
            "statusMessage": "Linting...",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
