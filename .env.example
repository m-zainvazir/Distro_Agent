# DistroAgent — required environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Core ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
# Optional LLM failover — if set, groq_chat() retries on a second key/model when
# the primary returns a retryable error (rate limit / 5xx). Leave blank to disable.
GROQ_API_KEY_FALLBACK=
GROQ_MODEL_FALLBACK=

# ── Database ──────────────────────────────────────────────────────────────────
# Production: Neon managed Postgres → https://neon.tech (use the pooled connection
# string, and keep the +asyncpg driver prefix).
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/distroagent

# ── Cache / state store (Redis) ───────────────────────────────────────────────
# Backs HITL pending-approval + discovery task state so it survives restarts and
# is shared across workers. If unreachable the app degrades to a per-process dict
# (single-worker only) and logs `state_store_memory_fallback`.
#   Local:      redis://localhost:6379
#   Production: Upstash (free serverless Redis) → https://upstash.com
#               Use the TLS URL it gives you, e.g. rediss://default:<pwd>@<host>:6379
REDIS_URL=redis://localhost:6379

# ── Vector DB (Qdrant) ────────────────────────────────────────────────────────
# Stores brand-aesthetic embeddings for similarity search. If unreachable the app
# logs `qdrant_init_failed` and similarity is silently skipped (outreach still works).
#   Local:      http://localhost:6333  (API key blank)
#   Production: Qdrant Cloud (free 1 GB cluster) → https://cloud.qdrant.io
#               QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                          # leave blank for local; required for Qdrant Cloud

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=replace-with-64-char-random-hex

# ── CORS (production: your Vercel URL) ────────────────────────────────────────
CORS_ORIGINS=*

# ── Governance (admin approval links) ─────────────────────────────────────────
BASE_URL=http://localhost:8000               # production: https://distroagent.fly.dev
ADMIN_PHONE=                                 # defaults to WHATSAPP_FOUNDER_PHONE if blank

# ── LangSmith (optional) ──────────────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=distroagent

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_FOUNDER_PHONE=                  # e.g. +12125551234 — receives deal alerts and approval cards

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG...

# ── Gmail OAuth (scope: gmail.readonly) ───────────────────────────────────────
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ── Google Calendar OAuth (scope: calendar.events) ────────────────────────────
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REFRESH_TOKEN=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...          # test mode: sk_test_..., production: sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...        # from Stripe Dashboard → Webhooks → signing secret
# Register webhook endpoint: POST https://your-domain/api/v1/webhooks/stripe
# Events to enable: invoice.payment_succeeded, invoice.payment_failed, invoice.marked_uncollectible

# ── Etsy (optional) ───────────────────────────────────────────────────────────
ETSY_API_KEY=

# ── Retention sweep ───────────────────────────────────────────────────────────
# Pick ONE way to run the restock/retention sweep:
#  (a) In-process loop — set the interval > 0 and it runs inside the live service
#      (no extra infra). 24 = once a day. 0 = disabled.
RETENTION_SWEEP_INTERVAL_HOURS=0
#  (b) External cron — leave the interval at 0, set a shared token here, then have
#      a cron POST https://your-domain/api/v1/retention/run with header
#      `X-Cron-Token: <this value>`. Blank token = endpoint returns 503.
CRON_TOKEN=

# ── Domain provisioning (optional — vertical subdomain wedge) ──────────────────
# Required only for POST /api/v1/domains/provision; otherwise the endpoint 503s.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
